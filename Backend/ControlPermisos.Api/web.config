<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de IIS para la API publicada en la aplicación /ApiControlPermisos/.
     Al publicar, el SDK completa processPath y hostingModel del elemento aspNetCore. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV, si está instalado en el servidor, bloquea PUT y DELETE (editar y quitar registros) con error 405. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Para diagnosticar un error 500.30 al arrancar: stdoutLogEnabled="true" y dar permiso de escritura
           al pool sobre la carpeta logs. -->
      <aspNetCore processPath=".\ControlPermisos.Api.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess" />
      <!-- Las demás cabeceras de seguridad las agrega la API (Infrastructure/SecurityHeaders.cs). -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
